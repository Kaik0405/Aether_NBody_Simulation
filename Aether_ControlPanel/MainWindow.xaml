<Window x:Class="Aether_ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Aether N-Body Simulation" Width="1500" Height="900"
        Background="#10161E" Foreground="#EAF4FF" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="320">
            <TextBlock Text="AETHER CONTROL PANEL" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Raylib renders the universe. This panel controls it." Margin="0,4,0,18" Foreground="#AAB9C8" />

            <GroupBox Header="Simulation" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="StartButton" Content="Start simulation" Click="StartButton_Click" Height="32" />
                    <Button Content="Pause / Resume" Click="PauseButton_Click" Height="32" Margin="0,8,0,0" />
                    <TextBlock Text="Simulation speed" Margin="0,14,0,2" />
                    <Slider x:Name="SpeedSlider" Minimum="0.125" Maximum="32" Value="1" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="SpeedSlider_ValueChanged" />
                    <TextBlock x:Name="SpeedLabel" Text="1x" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Scene generator" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <ComboBox x:Name="SceneBox" DisplayMemberPath="Name" Height="30" />
                    <Button Content="Load selected scene" Click="LoadSceneButton_Click" Height="32" Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Spawn body" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Type" VerticalAlignment="Center" />
                    <ComboBox x:Name="BodyTypeBox" Grid.Column="1" Height="28" />
                    <TextBlock Text="Mass" Grid.Row="1" VerticalAlignment="Center" />
                    <TextBox x:Name="MassBox" Text="40" Grid.Row="1" Grid.Column="1" Height="28" />
                    <TextBlock Text="Radius" Grid.Row="2" VerticalAlignment="Center" />
                    <TextBox x:Name="RadiusBox" Text="8" Grid.Row="2" Grid.Column="1" Height="28" />
                    <TextBlock Text="World X" Grid.Row="3" VerticalAlignment="Center" />
                    <TextBox x:Name="XBox" Text="0" Grid.Row="3" Grid.Column="1" Height="28" />
                    <TextBlock Text="World Y" Grid.Row="4" VerticalAlignment="Center" />
                    <TextBox x:Name="YBox" Text="0" Grid.Row="4" Grid.Column="1" Height="28" />
                </Grid>
            </GroupBox>
            <Button Content="Spawn body" Click="SpawnButton_Click" Height="34" />
            <GroupBox Header="Select body at world coordinates" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SelectXBox" Text="0" Width="100" Margin="0,0,8,0" />
                        <TextBox x:Name="SelectYBox" Text="0" Width="100" />
                        <Button Content="Select" Click="SelectButton_Click" Width="80" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SelectedInfoText" Text="No body selected" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </GroupBox>
            <Button Content="Delete selected body" Click="DeleteButton_Click" Height="34" Margin="0,8,0,0" />
            <TextBlock x:Name="StatusText" Text="Not connected" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#AAB9C8" />
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Margin="0,12,12,12" Background="#05080C" BorderBrush="#30465A" BorderThickness="1">
            <wfi:WindowsFormsHost x:Name="RaylibHost" />
        </Border>
    </Grid>
</Window>
